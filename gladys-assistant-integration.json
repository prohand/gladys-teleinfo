{
  "manifest_version": 1,
  "type": "device",
  "name": "Teleinfo",
  "description": {
    "en": "Reads your Linky or electronic meter through the LiXee TIC module.",
    "fr": "Lit votre compteur Linky ou électronique via le module TIC LiXee.",
    "de": "Liest deinen Linky- oder elektronischen Zähler über das LiXee-TIC-Modul aus.",
    "es": "Lee su contador Linky o electrónico a través del módulo TIC LiXee."
  },
  "version": "1.3.0",
  "docker_image": "ghcr.io/prohand/gladys-teleinfo:1.3.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/prohand/gladys-teleinfo/main/cover.png",
  "categories": ["energy"],
  "keywords": [
    "enedis",
    "zlinky",
    "ser2net",
    "téléinformation",
    "electricity meter",
    "compteur électrique",
    "heures creuses",
    "tempo",
    "consommation électrique"
  ],
  "countries": ["FR"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer",
        "de": "Erste Schritte",
        "es": "Primeros pasos"
      },
      "description": {
        "en": "Gladys integrations cannot open a USB port. Plug the LiXee TIC module into a machine of your network and share it with ser2net (raw TCP, 1200 bauds 7E1 in historic mode, 9600 bauds 7E1 in standard mode), then enter its address below.",
        "fr": "Les intégrations Gladys ne peuvent pas ouvrir un port USB. Branchez le module TIC LiXee sur une machine de votre réseau et partagez-le avec ser2net (TCP brut, 1200 bauds 7E1 en mode historique, 9600 bauds 7E1 en mode standard), puis indiquez son adresse ci-dessous.",
        "de": "Gladys-Integrationen können keinen USB-Port öffnen. Schließ das LiXee-TIC-Modul an einen Rechner in deinem Netzwerk an, gib es mit ser2net frei (rohes TCP, 1200 Baud 7E1 im historischen Modus, 9600 Baud 7E1 im Standardmodus) und trage dann unten seine Adresse ein.",
        "es": "Las integraciones de Gladys no pueden abrir un puerto USB. Conecte el módulo TIC LiXee a un equipo de su red, compártalo con ser2net (TCP sin procesar, 1200 baudios 7E1 en modo histórico, 9600 baudios 7E1 en modo estándar) y después introduzca su dirección a continuación."
      },
      "links": [
        {
          "url": "https://github.com/prohand/gladys-teleinfo/blob/main/docs/fr.md",
          "label": {
            "en": "Step-by-step guide",
            "fr": "Guide pas à pas",
            "de": "Schritt-für-Schritt-Anleitung",
            "es": "Guía paso a paso"
          }
        }
      ]
    },
    {
      "key": "host",
      "type": "string",
      "label": {
        "en": "Bridge address",
        "fr": "Adresse de la passerelle",
        "de": "Bridge-Adresse",
        "es": "Dirección de la pasarela"
      },
      "description": {
        "en": "IP address or host name of the machine running ser2net.",
        "fr": "Adresse IP ou nom de la machine qui fait tourner ser2net.",
        "de": "IP-Adresse oder Hostname des Rechners, auf dem ser2net läuft.",
        "es": "Dirección IP o nombre del equipo en el que se ejecuta ser2net."
      },
      "placeholder": {
        "en": "e.g. 192.168.1.20",
        "fr": "ex. 192.168.1.20",
        "de": "z. B. 192.168.1.20",
        "es": "p. ej. 192.168.1.20"
      },
      "required": true
    },
    {
      "key": "port",
      "type": "number",
      "label": {
        "en": "TCP port",
        "fr": "Port TCP",
        "de": "TCP-Port",
        "es": "Puerto TCP"
      },
      "description": {
        "en": "TCP port ser2net listens on for the TIC module.",
        "fr": "Port TCP sur lequel ser2net écoute pour le module TIC.",
        "de": "TCP-Port, auf dem ser2net für das TIC-Modul lauscht.",
        "es": "Puerto TCP en el que ser2net escucha para el módulo TIC."
      },
      "placeholder": {
        "en": "e.g. 2000",
        "fr": "ex. 2000",
        "de": "z. B. 2000",
        "es": "p. ej. 2000"
      },
      "required": true,
      "default": 2000,
      "min": 1,
      "max": 65535
    },
    {
      "key": "publish_interval",
      "type": "number",
      "label": {
        "en": "Publish interval (s)",
        "fr": "Intervalle d'envoi (s)",
        "de": "Sendeintervall (s)",
        "es": "Intervalo de envío (s)"
      },
      "description": {
        "en": "How often the values are sent to Gladys, in seconds. Unchanged values are not re-sent.",
        "fr": "Fréquence d'envoi des valeurs à Gladys, en secondes. Les valeurs inchangées ne sont pas renvoyées.",
        "de": "Wie oft die Werte an Gladys gesendet werden, in Sekunden. Unveränderte Werte werden nicht erneut gesendet.",
        "es": "Frecuencia de envío de los valores a Gladys, en segundos. Los valores sin cambios no se reenvían."
      },
      "required": false,
      "default": 60,
      "min": 15,
      "max": 3600
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "timeout_seconds": 30
    }
  ],
  "scene_triggers": [
    {
      "key": "tariff_period_changed",
      "label": {
        "en": "Tariff period changed",
        "fr": "Changement de période tarifaire",
        "de": "Tarifzeitraum gewechselt",
        "es": "Cambio de periodo tarifario"
      },
      "description": {
        "en": "The meter switched tariff period (off-peak, peak…).",
        "fr": "Le compteur a changé de période tarifaire (heures creuses, pleines…).",
        "de": "Der Zähler hat den Tarifzeitraum gewechselt (Niedertarif, Hochtarif…).",
        "es": "El contador ha cambiado de periodo tarifario (horas valle, horas punta…)."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Meter",
            "fr": "Compteur",
            "de": "Zähler",
            "es": "Contador"
          }
        },
        {
          "key": "period_type",
          "type": "multi_select",
          "label": {
            "en": "New period",
            "fr": "Nouvelle période",
            "de": "Neuer Zeitraum",
            "es": "Nuevo periodo"
          },
          "options": [
            {
              "value": "off_peak",
              "label": {
                "en": "Off-peak hours",
                "fr": "Heures creuses",
                "de": "Niedertarif",
                "es": "Horas valle"
              }
            },
            {
              "value": "peak",
              "label": {
                "en": "Peak hours",
                "fr": "Heures pleines",
                "de": "Hochtarif",
                "es": "Horas punta"
              }
            },
            {
              "value": "base",
              "label": {
                "en": "Single rate",
                "fr": "Base / toutes heures",
                "de": "Einheitstarif",
                "es": "Tarifa única"
              }
            },
            {
              "value": "other",
              "label": {
                "en": "Other",
                "fr": "Autre",
                "de": "Sonstige",
                "es": "Otro"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "period",
          "type": "string",
          "label": {
            "en": "New period (meter label)",
            "fr": "Nouvelle période (libellé compteur)",
            "de": "Neuer Zeitraum (Zählerbezeichnung)",
            "es": "Nuevo periodo (etiqueta del contador)"
          }
        },
        {
          "key": "period_type",
          "type": "string",
          "label": {
            "en": "New period type",
            "fr": "Type de la nouvelle période",
            "de": "Art des neuen Zeitraums",
            "es": "Tipo del nuevo periodo"
          }
        },
        {
          "key": "previous_period",
          "type": "string",
          "label": {
            "en": "Previous period",
            "fr": "Période précédente",
            "de": "Vorheriger Zeitraum",
            "es": "Periodo anterior"
          }
        }
      ]
    },
    {
      "key": "overload_started",
      "label": {
        "en": "Subscribed power exceeded",
        "fr": "Dépassement de puissance souscrite",
        "de": "Vertragsleistung überschritten",
        "es": "Potencia contratada superada"
      },
      "description": {
        "en": "The power drawn went over the subscription (risk of tripping).",
        "fr": "La puissance consommée dépasse l'abonnement (risque de disjonction).",
        "de": "Die bezogene Leistung liegt über der Vertragsleistung (Auslösegefahr).",
        "es": "La potencia consumida supera la contratada (riesgo de que salte el limitador)."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Meter",
            "fr": "Compteur",
            "de": "Zähler",
            "es": "Contador"
          }
        }
      ],
      "variables": [
        {
          "key": "power",
          "type": "number",
          "label": {
            "en": "Apparent power (VA)",
            "fr": "Puissance apparente (VA)",
            "de": "Scheinleistung (VA)",
            "es": "Potencia aparente (VA)"
          }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "read_meter",
      "label": {
        "en": "Read the meter",
        "fr": "Lire le compteur",
        "de": "Zähler auslesen",
        "es": "Leer el contador"
      },
      "description": {
        "en": "Returns the power, tariff period and index of the meter.",
        "fr": "Renvoie la puissance, la période tarifaire et l'index du compteur.",
        "de": "Liefert Leistung, Tarifzeitraum und Zählerstand des Zählers.",
        "es": "Devuelve la potencia, el periodo tarifario y la lectura del contador."
      },
      "timeout_seconds": 10,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Meter",
            "fr": "Compteur",
            "de": "Zähler",
            "es": "Contador"
          },
          "required": true
        }
      ],
      "outputs": [
        {
          "key": "available",
          "type": "boolean",
          "label": {
            "en": "Meter readable",
            "fr": "Compteur lisible",
            "de": "Zähler lesbar",
            "es": "Contador legible"
          }
        },
        {
          "key": "power",
          "type": "number",
          "label": {
            "en": "Apparent power (VA)",
            "fr": "Puissance apparente (VA)",
            "de": "Scheinleistung (VA)",
            "es": "Potencia aparente (VA)"
          }
        },
        {
          "key": "period",
          "type": "string",
          "label": {
            "en": "Tariff period",
            "fr": "Période tarifaire",
            "de": "Tarifzeitraum",
            "es": "Periodo tarifario"
          }
        },
        {
          "key": "period_type",
          "type": "string",
          "label": {
            "en": "Tariff period type",
            "fr": "Type de période tarifaire",
            "de": "Art des Tarifzeitraums",
            "es": "Tipo de periodo tarifario"
          }
        },
        {
          "key": "index_kwh",
          "type": "number",
          "label": {
            "en": "Total index (kWh)",
            "fr": "Index total (kWh)",
            "de": "Gesamtzählerstand (kWh)",
            "es": "Lectura total (kWh)"
          }
        },
        {
          "key": "overload",
          "type": "boolean",
          "label": {
            "en": "Overload in progress",
            "fr": "Dépassement en cours",
            "de": "Überschreitung läuft",
            "es": "Sobrecarga en curso"
          }
        }
      ]
    }
  ],
  "widgets": [
    {
      "key": "meter",
      "label": {
        "en": "Electricity meter",
        "fr": "Compteur électrique",
        "de": "Stromzähler",
        "es": "Contador eléctrico"
      },
      "description": {
        "en": "Live power, index, 24 h curve, tariff period and overload.",
        "fr": "Puissance en direct, index, courbe 24 h, période tarifaire et dépassement.",
        "de": "Live-Leistung, Zählerstand, 24-h-Kurve, Tarifzeitraum und Überschreitung.",
        "es": "Potencia en directo, lectura, curva de 24 h, periodo tarifario y sobrecarga."
      },
      "icon": "zap",
      "settings": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Meter",
            "fr": "Compteur",
            "de": "Zähler",
            "es": "Contador"
          },
          "required": true
        }
      ]
    }
  ]
}
