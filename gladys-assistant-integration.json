{
  "manifest_version": 1,
  "type": "device",
  "name": "Teleinfo",
  "description": {
    "en": "Reads your Linky or electronic meter through the LiXee TIC module.",
    "fr": "Lit votre compteur Linky ou électronique via le module TIC LiXee."
  },
  "version": "1.1.0",
  "docker_image": "ghcr.io/prohand/gladys-teleinfo:1.1.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/prohand/gladys-teleinfo/main/cover.png",
  "categories": ["energy"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer"
      },
      "description": {
        "en": "Gladys integrations cannot open a USB port. Plug the LiXee TIC module into a machine of your network and share it with ser2net (raw TCP, 1200 bauds 7E1 in historic mode, 9600 bauds 7E1 in standard mode), then enter its address below.",
        "fr": "Les intégrations Gladys ne peuvent pas ouvrir un port USB. Branchez le module TIC LiXee sur une machine de votre réseau et partagez-le avec ser2net (TCP brut, 1200 bauds 7E1 en mode historique, 9600 bauds 7E1 en mode standard), puis indiquez son adresse ci-dessous."
      },
      "links": [
        {
          "url": "https://github.com/prohand/gladys-teleinfo/blob/main/docs/fr.md",
          "label": {
            "en": "Step-by-step guide",
            "fr": "Guide pas à pas"
          }
        }
      ]
    },
    {
      "key": "host",
      "type": "string",
      "label": {
        "en": "Bridge address",
        "fr": "Adresse de la passerelle"
      },
      "description": {
        "en": "IP address or host name of the machine running ser2net.",
        "fr": "Adresse IP ou nom de la machine qui fait tourner ser2net."
      },
      "placeholder": {
        "en": "e.g. 192.168.1.20",
        "fr": "ex. 192.168.1.20"
      },
      "required": true
    },
    {
      "key": "port",
      "type": "number",
      "label": {
        "en": "TCP port",
        "fr": "Port TCP"
      },
      "description": {
        "en": "TCP port ser2net listens on for the TIC module.",
        "fr": "Port TCP sur lequel ser2net écoute pour le module TIC."
      },
      "placeholder": {
        "en": "e.g. 2000",
        "fr": "ex. 2000"
      },
      "required": true,
      "default": 2000,
      "min": 1,
      "max": 65535
    },
    {
      "key": "publish_interval",
      "type": "number",
      "label": {
        "en": "Publish interval (s)",
        "fr": "Intervalle d'envoi (s)"
      },
      "description": {
        "en": "How often the values are sent to Gladys, in seconds. Unchanged values are not re-sent.",
        "fr": "Fréquence d'envoi des valeurs à Gladys, en secondes. Les valeurs inchangées ne sont pas renvoyées."
      },
      "required": false,
      "default": 60,
      "min": 15,
      "max": 3600
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion"
      },
      "timeout_seconds": 30
    }
  ],
  "scene_triggers": [
    {
      "key": "tariff_period_changed",
      "label": {
        "en": "Tariff period changed",
        "fr": "Changement de période tarifaire"
      },
      "description": {
        "en": "The meter switched tariff period (off-peak, peak…).",
        "fr": "Le compteur a changé de période tarifaire (heures creuses, pleines…)."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Meter",
            "fr": "Compteur"
          }
        },
        {
          "key": "period_type",
          "type": "multi_select",
          "label": {
            "en": "New period",
            "fr": "Nouvelle période"
          },
          "options": [
            {
              "value": "off_peak",
              "label": {
                "en": "Off-peak hours",
                "fr": "Heures creuses"
              }
            },
            {
              "value": "peak",
              "label": {
                "en": "Peak hours",
                "fr": "Heures pleines"
              }
            },
            {
              "value": "base",
              "label": {
                "en": "Single rate",
                "fr": "Base / toutes heures"
              }
            },
            {
              "value": "other",
              "label": {
                "en": "Other",
                "fr": "Autre"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "period",
          "type": "string",
          "label": {
            "en": "New period (meter label)",
            "fr": "Nouvelle période (libellé compteur)"
          }
        },
        {
          "key": "period_type",
          "type": "string",
          "label": {
            "en": "New period type",
            "fr": "Type de la nouvelle période"
          }
        },
        {
          "key": "previous_period",
          "type": "string",
          "label": {
            "en": "Previous period",
            "fr": "Période précédente"
          }
        }
      ]
    },
    {
      "key": "overload_started",
      "label": {
        "en": "Subscribed power exceeded",
        "fr": "Dépassement de puissance souscrite"
      },
      "description": {
        "en": "The power drawn went over the subscription (risk of tripping).",
        "fr": "La puissance consommée dépasse l'abonnement (risque de disjonction)."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Meter",
            "fr": "Compteur"
          }
        }
      ],
      "variables": [
        {
          "key": "power",
          "type": "number",
          "label": {
            "en": "Apparent power (VA)",
            "fr": "Puissance apparente (VA)"
          }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "read_meter",
      "label": {
        "en": "Read the meter",
        "fr": "Lire le compteur"
      },
      "description": {
        "en": "Returns the power, tariff period and index of the meter.",
        "fr": "Renvoie la puissance, la période tarifaire et l'index du compteur."
      },
      "timeout_seconds": 10,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Meter",
            "fr": "Compteur"
          },
          "required": true
        }
      ],
      "outputs": [
        {
          "key": "available",
          "type": "boolean",
          "label": {
            "en": "Meter readable",
            "fr": "Compteur lisible"
          }
        },
        {
          "key": "power",
          "type": "number",
          "label": {
            "en": "Apparent power (VA)",
            "fr": "Puissance apparente (VA)"
          }
        },
        {
          "key": "period",
          "type": "string",
          "label": {
            "en": "Tariff period",
            "fr": "Période tarifaire"
          }
        },
        {
          "key": "period_type",
          "type": "string",
          "label": {
            "en": "Tariff period type",
            "fr": "Type de période tarifaire"
          }
        },
        {
          "key": "index_kwh",
          "type": "number",
          "label": {
            "en": "Total index (kWh)",
            "fr": "Index total (kWh)"
          }
        },
        {
          "key": "overload",
          "type": "boolean",
          "label": {
            "en": "Overload in progress",
            "fr": "Dépassement en cours"
          }
        }
      ]
    }
  ],
  "widgets": [
    {
      "key": "meter",
      "label": {
        "en": "Electricity meter",
        "fr": "Compteur électrique"
      },
      "description": {
        "en": "Live power, index, 24 h curve, tariff period and overload.",
        "fr": "Puissance en direct, index, courbe 24 h, période tarifaire et dépassement."
      },
      "icon": "zap",
      "settings": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Meter",
            "fr": "Compteur"
          },
          "required": true
        }
      ]
    }
  ]
}
